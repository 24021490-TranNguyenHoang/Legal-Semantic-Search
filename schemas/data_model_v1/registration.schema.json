{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vtls:registration:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "dataset_kind",
    "snapshot_date",
    "file_id_namespace",
    "documents",
    "files"
  ],
  "properties": {
    "contract_version": {
      "const": "source-registration.v1"
    },
    "dataset_kind": {
      "enum": [
        "legal_sources",
        "synthetic_fixture"
      ]
    },
    "snapshot_date": {
      "const": "2025-01-01"
    },
    "file_id_namespace": {
      "type": "string",
      "format": "uuid"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "law_id",
          "declared"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "law_id": {
            "type": "string",
            "minLength": 1
          },
          "declared": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "law_title",
              "document_type",
              "scope_note",
              "source_url_candidate",
              "issued_date_candidate",
              "inventory_ref"
            ],
            "properties": {
              "law_title": {
                "type": "string",
                "minLength": 1
              },
              "document_type": {
                "enum": [
                  "law",
                  "decree",
                  "circular",
                  "regulation"
                ]
              },
              "scope_note": {
                "type": "string",
                "minLength": 1
              },
              "source_url_candidate": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              "issued_date_candidate": {
                "type": "string",
                "format": "date"
              },
              "inventory_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "law_id",
          "source_set_id",
          "part_order",
          "file_role",
          "raw_file_ref",
          "expected_sha256"
        ],
        "properties": {
          "law_id": {
            "type": "string",
            "minLength": 1
          },
          "source_set_id": {
            "type": "string",
            "minLength": 1
          },
          "part_order": {
            "type": "integer",
            "minimum": 1
          },
          "file_role": {
            "enum": [
              "main",
              "continuation",
              "annex",
              "alternate"
            ]
          },
          "raw_file_ref": {
            "type": "string",
            "minLength": 1
          },
          "expected_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
