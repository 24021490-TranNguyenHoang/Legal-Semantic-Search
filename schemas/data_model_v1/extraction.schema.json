{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vtls:extraction:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "extraction_id",
    "file_id",
    "method",
    "tool_version",
    "text_ref",
    "text_sha256",
    "char_count",
    "review_status",
    "created_at"
  ],
  "properties": {
    "extraction_id": {
      "type": "string",
      "minLength": 1
    },
    "file_id": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "enum": [
        "pdf_text",
        "html_text",
        "doc_text",
        "ocr"
      ]
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "text_ref": {
      "type": "string",
      "minLength": 1
    },
    "text_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "char_count": {
      "type": "integer",
      "minimum": 0
    },
    "review_status": {
      "enum": [
        "pending",
        "verified",
        "rejected"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
